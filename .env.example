# Local Supabase (from `npx supabase start`). These are the standard,
# publicly-documented local development keys — not secrets.
# For hosted Supabase, replace all three with your project's values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security — never expose to the client,
# never prefix with NEXT_PUBLIC_. Used only by scripts/verify-rls.mjs.
SUPABASE_SERVICE_ROLE_KEY=
